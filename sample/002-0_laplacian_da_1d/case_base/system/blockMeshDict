FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 1次元熱伝導棒: 長さ 0.3m × 0.1m × 0.1m、x方向に10セル (dx=0.03m)
// 節点0(x=0): 左端（熱入力側）  節点9(x=0.3m): 右端（周囲温度固定）
// 熱時定数 tau = L^2 / (pi^2 * alpha) = 0.09 / (9.87 * 1.2e-5) ≈ 760s

convertToMeters 1;

vertices
(
    (0    0    0   )   // 0
    (0.3  0    0   )   // 1
    (0.3  0.1  0   )   // 2
    (0    0.1  0   )   // 3
    (0    0    0.1 )   // 4
    (0.3  0    0.1 )   // 5
    (0.3  0.1  0.1 )   // 6
    (0    0.1  0.1 )   // 7
);

blocks
(
    // x方向に10セル、y/z方向は各1セル（擬似1次元）
    hex (0 1 2 3 4 5 6 7) (10 1 1) simpleGrading (1 1 1)
);

boundary
(
    left
    {
        type patch;
        faces ((0 4 7 3));   // x=0 面: 熱入力境界 (fixedGradient)
    }
    right
    {
        type patch;
        faces ((1 2 6 5));   // x=0.3m 面: 周囲温度固定 (fixedValue)
    }
    bottom
    {
        type empty;
        faces ((0 1 5 4));
    }
    top
    {
        type empty;
        faces ((3 7 6 2));
    }
    back
    {
        type empty;
        faces ((0 3 2 1));
    }
    front
    {
        type empty;
        faces ((4 5 6 7));
    }
);

