FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Python の da_main.py がこのファイルの endTime を毎ステップ書き換えて
// laplacianFoam を1ステップずつ実行する。

application     laplacianFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         900;        // da_main.py が毎ステップ書き換える

deltaT          10;        // 時間刻み [s]（001 の Python モデルと同じ）

writeControl    timeStep;

writeInterval   1;         // 毎ステップ書き込む

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //
